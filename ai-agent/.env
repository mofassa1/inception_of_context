# LLM runtime (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
ASK_MODEL=qwen2.5:3b
CODE_MODEL=qwen2.5-coder:3b

# Embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Point at the HF hub cache dir itself (new transformers treats this as cache_dir).
HF_CACHE=~/.cache/huggingface/hub

# Vector store
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=codebase
