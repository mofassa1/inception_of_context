#!/usr/bin/env bash
# Launch the desktop dashboard on a target project.
#   ioc               the demo project
#   ioc path/to/app   another project
#
# Starts the Architect API if its port is free, indexing and watching the
# target, and stops it again when the window closes. A server that was already
# running is left alone, so a `make api` from another terminal survives.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="${1:-$REPO_ROOT/demo}"

if [ ! -d "$TARGET" ]; then
  echo "ioc: not a directory: $TARGET" >&2
  exit 1
fi
export TARGET_PROJECT="$(cd "$TARGET" && pwd)"

if [ ! -d "$REPO_ROOT/p2/dashboard/dist" ]; then
  echo "ioc: dashboard not built — run 'make build' first" >&2
  exit 1
fi

port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

api_pid=""

# SIGTERM the process *group*: `set -m` plus `exec` makes uv the group leader,
# so the uvicorn grandchildren die with it. Killing the uv pid alone orphans
# them, and SIGTERM rather than SIGKILL lets the FastAPI shutdown lifespan run
# so the file watcher stops cleanly.
stop_api() {
  [ -n "$api_pid" ] && { kill -- -"$api_pid" 2>/dev/null || kill "$api_pid" 2>/dev/null; }
}

set -m
trap stop_api EXIT INT TERM

if port_busy 8000; then
  echo "ioc: architect api already running on :8000 — leaving it alone"
else
  ( cd "$REPO_ROOT" && exec uv run uvicorn --factory fix:create_app --host 127.0.0.1 --port 8000 ) &
  api_pid="$!"
  echo "ioc: started architect api on :8000 for $TARGET_PROJECT (pid $api_pid)"
fi

cd "$REPO_ROOT/p2/dashboard"
npx electron .
