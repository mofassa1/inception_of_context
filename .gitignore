# --- Runtime state: index, conversations, patch snapshots ---
# The subject rejects any submission that commits a populated ChromaDB
# directory, an embedding archive or an LLM weight. Everything the services
# write at runtime lives under .data/ so one rule covers all of it.
.data/
chroma_db/
*.sqlite3

# Generated by `make up` from the host's layout.
docker-compose.host.yml

# The models picked by `make install-models`.
models.mk

# One folder of logs per `make FOLDER=<folder>` run.
.logs/

# make showcase: the copy of demo/ it patches, its videos, chapters and test results.
.showcase/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Node / dashboard ---
node_modules/
dist/
dist-ssr/

# --- Model caches ---
.cache/
*.safetensors
*.gguf
*.bin

# --- Editors / OS ---
.DS_Store
Thumbs.db
*.local
*.log
.pytest_cache/

# --- From main ---
# tests/ and test.py are left out: they would hide our test suite.
chroma_db
p1/testing/
p1/chroma.sqlite3
p2/routes/__pycache__/
download_model.py
